.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/
.ipynb_checkpoints/

# dbt / DuckDB build artifacts (rebuilt by scripts/run_all.py)
warehouse/target/
warehouse/logs/
warehouse/dbt_packages/
warehouse/*.duckdb
warehouse/*.duckdb.wal
warehouse/.user.yml
logs/

# Live request logs may contain full prompts; only curated replay records go in data/replay/
runs/

# Sealed test set before reveal (only its SHA-256 is committed until the final evaluation)
evals/sealed/

# Private notes (not published)
docs/private/

# Archived HTS revisions (D2a): the PDFs (~174MB) and full page texts (~48MB) are not committed.
# Manifests (URL, time, size, SHA-256), comparison outputs, change records and the evidence snapshot are.
# Rebuild with: uv run python scripts/rehydrate_hts_archive.py
data/raw/hts_archive/*/*.pdf
data/extracted/hts_archive/*/pages/
